{
  "name": "@jg-app/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "build": "true",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "bun run prisma/seed.ts",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@hono/valibot-validator": "^0.5.3",
    "@jg-app/shared": "workspace:*",
    "@jg-app/validators": "workspace:*",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "^6.19.3",
    "@scalar/hono-api-reference": "^0.12.20",
    "better-auth": "^1.7.18",
    "exceljs": "^4.4.0",
    "hono": "^4.12.21",
    "hono-pino": "^0.10.3",
    "pg-boss": "^12.38.2",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "@hono/cli": "^1.0.0-rc.9",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.19.19",
    "dotenv": "^18.0.10",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.166.0"
  }
}
