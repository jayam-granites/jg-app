{
  "name": "@jg-app/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "predev": "bun run prisma:generate",
    "dev": "bun run --watch src/index.ts",
    "build": "true",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "bun run prisma/seed.ts"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "dependencies": {
    "@hono/valibot-validator": "^0.5.3",
    "@jg-app/shared": "workspace:*",
    "@jg-app/validators": "workspace:*",
    "@prisma/client": "^6.19.3",
    "hono": "^4.12.21",
    "hono-pino": "^0.10.3",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.19.19",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3"
  }
}
