generator client {
  provider   = "prisma-client-js"
  // Client engine (no Rust binary) so the generated client runs on Cloudflare Workers.
  // Requires a driver adapter - see src/lib/prisma.ts.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String
  emailVerified Boolean       @default(false)
  image         String?
  role          String        @default("sales")
  isSuspended   Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      AuthSession[]
  authAccounts  AuthAccount[]

  @@map("users")
}

model AuthSession {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verifications")
}

enum CategoryType {
  PRODUCT
  EXPENSE
  SERVICE
  PURCHASE
}

enum AccountType {
  CASH
  UPI
  BANK_ACCOUNT
}

enum AccountTransactionType {
  INVOICE_PAYMENT
  EXPENSE
  INITIAL_BALANCE
  MANUAL_ADJUSTMENT
}

enum PurchaseStatus {
  DRAFT
  APPROVED
  PARTIAL_RECEIVED
  COMPLETED
  CANCELLED
}

enum TradeContactType {
  ENGINEER
  BUILDER
  MASTRI
}

enum TierGroup {
  GOLD
  SILVER
  BRONZE
}

enum EnquiryStatus {
  OPEN
  FOLLOW_UP_1
  FOLLOW_UP_2
  CLOSED_WON
  CLOSED_LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ExpenseFrequency {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

model Category {
  id Int @id @default(autoincrement())

  parentId Int? @map("parent_id")

  name String

  type CategoryType

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  parent Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])

  children Category[] @relation("CategoryHierarchy")

  products Product[]

  attributes CategoryAttribute[]

  expenses Expense[]

  expenseSchedules ExpenseSchedule[]

  @@unique([parentId, name])
  @@map("categories")
}

model Unit {
  id Int @id @default(autoincrement())

  code String @unique

  name String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  variants ProductVariant[] @relation("PrimaryUnit")

  secondaryVariants ProductVariant[] @relation("SecondaryUnit")

  invoiceItems InvoiceItem[] @relation("InvoiceUnit")

  invoiceSecondaryItems InvoiceItem[] @relation("InvoiceSecondaryUnit")

  @@map("units")
}

model Product {
  id Int @id @default(autoincrement())

  categoryId Int @map("category_id")

  name String

  description String?

  hsnCode String? @map("hsn_code")

  lotNumber String? @map("lot_number")

  widthReduction Decimal? @default(0) @map("width_reduction") @db.Decimal(12, 2)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id])

  variants ProductVariant[]

  slabs Slab[]

  @@map("products")
}

model Slab {
  id Int @id @default(autoincrement())

  productId Int @map("product_id")

  measurementId Int? @map("measurement_id")

  slabNumber Int @map("slab_number")

  width Decimal @db.Decimal(12, 2)

  height Decimal @db.Decimal(12, 2)

  area Decimal @db.Decimal(12, 2)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  measurement Measurement? @relation(fields: [measurementId], references: [id])

  @@map("slabs")
}

model Measurement {
  id Int @id @default(autoincrement())

  measurementNumber String @unique @map("measurement_number")

  name String @default("")

  phone String? @map("phone")

  address String? @map("address")

  notes String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  slabs Slab[]

  @@map("measurements")
}

model ProductVariant {
  id Int @id @default(autoincrement())

  productId Int @map("product_id")

  unitId Int @map("unit_id")

  secondaryUnitId Int? @map("secondary_unit_id")

  skuCode String @unique @map("sku_code")

  mrp Decimal @db.Decimal(12, 2)

  sellingPrice Decimal @map("selling_price") @db.Decimal(12, 2)

  gstPercent Decimal? @map("gst_percent") @db.Decimal(5, 2)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  unit Unit @relation("PrimaryUnit", fields: [unitId], references: [id])

  secondaryUnit Unit? @relation("SecondaryUnit", fields: [secondaryUnitId], references: [id])

  attributes ProductVariantAttribute[]

  purchaseItems PurchaseOrderItem[]

  receiptItems PurchaseReceiptItem[]

  inventoryBatches InventoryBatch[]

  invoiceItems InvoiceItem[]

  @@map("product_variants")
}

model Attribute {
  id Int @id @default(autoincrement())

  code String @unique

  name String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  categories CategoryAttribute[]

  values AttributeValue[]

  productVariantAttributes ProductVariantAttribute[]

  @@map("attributes")
}

model CategoryAttribute {
  id Int @id @default(autoincrement())

  categoryId Int @map("category_id")

  attributeId Int @map("attribute_id")

  isRequired Boolean @default(false) @map("is_required")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id])

  attribute Attribute @relation(fields: [attributeId], references: [id])

  @@unique([categoryId, attributeId])
  @@map("category_attributes")
}

model AttributeValue {
  id Int @id @default(autoincrement())

  attributeId Int @map("attribute_id")

  value String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  attribute Attribute @relation(fields: [attributeId], references: [id])

  variants ProductVariantAttribute[]

  @@unique([attributeId, value])
  @@map("attribute_values")
}

model ProductVariantAttribute {
  id Int @id @default(autoincrement())

  productVariantId Int @map("product_variant_id")

  attributeId Int @map("attribute_id")

  attributeValueId Int @map("attribute_value_id")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  attribute Attribute @relation(fields: [attributeId], references: [id])

  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id])

  @@unique([productVariantId, attributeId])
  @@map("product_variant_attributes")
}

model Supplier {
  id Int @id @default(autoincrement())

  name String

  mobile String?

  address String?

  gstNumber String? @map("gst_number")

  bankName String? @map("bank_name") @db.VarChar(255)

  accountNumber String? @unique @map("account_number") @db.VarChar(100)

  ifscCode String? @map("ifsc_code") @db.VarChar(20)

  branchName String? @map("branch_name") @db.VarChar(100)

  upiId String? @map("upi_id") @db.VarChar(100)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]

  tasks Task[]

  @@map("suppliers")
}

model PurchaseOrder {
  id Int @id @default(autoincrement())

  poNumber String @unique @map("po_number")

  supplierId Int @map("supplier_id")

  orderDate DateTime @map("order_date")

  expectedDate DateTime? @map("expected_date")

  status PurchaseStatus @default(DRAFT)

  remarks String?

  subtotal Decimal? @db.Decimal(12, 2)

  totalExpense Decimal? @map("total_expense") @db.Decimal(12, 2)

  grandTotal Decimal? @map("grand_total") @db.Decimal(12, 2)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])

  items PurchaseOrderItem[]

  receipts PurchaseReceipt[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id Int @id @default(autoincrement())

  purchaseOrderId Int @map("purchase_order_id")

  productVariantId Int @map("product_variant_id")

  orderedQty Decimal? @map("ordered_qty") @db.Decimal(12, 3)

  expectedSlabCount Int? @map("expected_slab_count")

  unitPrice Decimal? @map("unit_price") @db.Decimal(12, 2)

  amount Decimal? @db.Decimal(12, 2)

  remarks String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  receiptItems PurchaseReceiptItem[]

  @@map("purchase_order_items")
}

model PurchaseReceipt {
  id Int @id @default(autoincrement())

  purchaseOrderId Int @map("purchase_order_id")

  receiptNumber String @unique @map("receipt_number")

  vehicleNumber String? @map("vehicle_number")

  invoiceNumber String? @map("invoice_number")

  receivedDate DateTime @map("received_date")

  totalSqfts Decimal? @map("total_sqfts") @db.Decimal(12, 3)

  totalSlabs Int? @map("total_slabs")

  subtotal Decimal? @map("subtotal") @db.Decimal(12, 2)

  adjustment Decimal? @map("adjustment") @db.Decimal(12, 2)

  netTotal Decimal? @map("net_total") @db.Decimal(12, 2)

  gstCalculationMode String @default("OVERALL") @map("gst_calculation_mode")

  gstPercentage Decimal? @map("gst_percentage") @db.Decimal(5, 2)

  gstInvoiceSqft Decimal? @map("gst_invoice_sqft") @db.Decimal(12, 3)

  gstInvoiceRate Decimal? @map("gst_invoice_rate") @db.Decimal(12, 2)

  gstInvoiceBaseValue Decimal? @map("gst_invoice_base_value") @db.Decimal(12, 2)

  gstInvoiceGst Decimal? @map("gst_invoice_gst") @db.Decimal(12, 2)

  gstInvoiceTotal Decimal? @map("gst_invoice_total") @db.Decimal(12, 2)

  cashPortion Decimal? @map("cash_portion") @db.Decimal(12, 2)

  billPayment Decimal? @map("bill_payment") @db.Decimal(12, 2)

  cashPayment Decimal? @map("cash_payment") @db.Decimal(12, 2)

  remarks String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  items PurchaseReceiptItem[]

  expenses Expense[]

  purchaseTransports PurchaseTransport[]

  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id Int @id @default(autoincrement())

  purchaseReceiptId Int @map("purchase_receipt_id")

  purchaseOrderItemId Int? @map("purchase_order_item_id")

  productVariantId Int @map("product_variant_id")

  batchNo String @map("batch_no")

  receivedQty Decimal @map("received_qty") @db.Decimal(12, 3)

  slabCount Int? @map("slab_count")

  damagedQty Decimal? @map("damaged_qty") @db.Decimal(12, 3)

  acceptedQty Decimal? @map("accepted_qty") @db.Decimal(12, 3)

  rejectedQty Decimal? @map("rejected_qty") @db.Decimal(12, 3)

  rate Decimal? @map("rate") @db.Decimal(12, 2)

  buyingPrice Decimal @map("buying_price") @db.Decimal(12, 2)

  landingPrice Decimal? @map("landing_price") @db.Decimal(12, 2)

  sellingPriceFrom Decimal? @map("selling_price_from") @db.Decimal(12, 2)

  sellingPriceTo Decimal? @map("selling_price_to") @db.Decimal(12, 2)

  widthAllowance Decimal? @map("width_allowance") @db.Decimal(12, 2)

  heightAllowance Decimal? @map("height_allowance") @db.Decimal(12, 2)

  gstInvoiceSqft Decimal? @map("gst_invoice_sqft") @db.Decimal(12, 3)

  gstInvoiceRate Decimal? @map("gst_invoice_rate") @db.Decimal(12, 2)

  gstInvoiceBaseValue Decimal? @map("gst_invoice_base_value") @db.Decimal(12, 2)

  gstInvoiceGst Decimal? @map("gst_invoice_gst") @db.Decimal(12, 2)

  gstInvoiceTotal Decimal? @map("gst_invoice_total") @db.Decimal(12, 2)

  cashPortion Decimal? @map("cash_portion") @db.Decimal(12, 2)

  remarks String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  purchaseReceipt PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id])

  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  slabs PurchaseReceiptSlab[]

  expenseAllocations ExpenseAllocation[]

  inventoryBatch InventoryBatch?

  @@map("purchase_receipt_items")
}

model PurchaseReceiptSlab {
  id Int @id @default(autoincrement())

  purchaseReceiptItemId Int @map("purchase_receipt_item_id")

  serialNo String? @map("serial_no")

  length Decimal? @db.Decimal(12, 2)

  width Decimal? @db.Decimal(12, 2)

  thickness Decimal? @db.Decimal(12, 2)

  sqft Decimal? @db.Decimal(12, 3)

  isCrack Boolean @default(false) @map("is_crack")

  isBroken Boolean @default(false) @map("is_broken")

  crackWidth Decimal? @map("crack_width") @db.Decimal(12, 2)

  crackHeight Decimal? @map("crack_height") @db.Decimal(12, 2)

  crackArea Decimal? @map("crack_area") @db.Decimal(12, 3)

  remarks String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  purchaseReceiptItem PurchaseReceiptItem @relation(fields: [purchaseReceiptItemId], references: [id])

  @@map("purchase_receipt_slabs")
}

model ExpenseSchedule {
  id Int @id @default(autoincrement())

  categoryId Int @map("category_id")

  title String

  frequency ExpenseFrequency

  amount Decimal? @db.Decimal(12, 2)

  startDate DateTime @map("start_date")

  endDate DateTime? @map("end_date")

  intervalDays Int? @map("interval_days")

  lastProcessedOccurrenceDate DateTime? @map("last_processed_occurrence_date")

  remarks String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id])

  expenses Expense[]

  @@map("expense_schedules")
}

model Expense {
  id Int @id @default(autoincrement())

  expenseNumber String @unique @map("expense_number")

  expenseDate DateTime @map("expense_date")

  categoryId Int @map("category_id")

  expenseScheduleId Int? @map("expense_schedule_id")

  scheduleOccurrenceDate DateTime? @map("schedule_occurrence_date")

  purchaseReceiptId Int? @map("purchase_receipt_id")

  amount Decimal @db.Decimal(12, 2)

  fromDate DateTime? @map("from_date")

  toDate DateTime? @map("to_date")

  remarks String?

  paymentMode     String? @map("payment_mode")
  accountId       Int?    @map("account_id")
  referenceNumber String? @map("reference_number")

  isPurchaseExpense Boolean @default(false) @map("is_purchase_expense")

  isPaid Boolean @default(false) @map("is_paid")

  paidDate DateTime? @map("paid_date")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id])

  expenseSchedule ExpenseSchedule? @relation(fields: [expenseScheduleId], references: [id])

  purchaseReceipt PurchaseReceipt? @relation(fields: [purchaseReceiptId], references: [id])

  allocations ExpenseAllocation[]

  @@unique([expenseScheduleId, scheduleOccurrenceDate])
  @@index([expenseDate, isActive, isPurchaseExpense])
  @@map("expenses")
}

model ExpenseAllocation {
  id Int @id @default(autoincrement())

  expenseId Int @map("expense_id")

  purchaseReceiptItemId Int @map("purchase_receipt_item_id")

  amount Decimal @db.Decimal(12, 2)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  expense Expense @relation(fields: [expenseId], references: [id])

  purchaseReceiptItem PurchaseReceiptItem @relation(fields: [purchaseReceiptItemId], references: [id])

  @@map("expense_allocations")
}

model InventoryBatch {
  id Int @id @default(autoincrement())

  purchaseReceiptItemId Int? @unique @map("purchase_receipt_item_id")

  productVariantId Int @map("product_variant_id")

  batchNo String @map("batch_no")

  slabCount Int? @map("slab_count")

  totalQty Decimal @map("total_qty") @db.Decimal(12, 3)

  availableQty Decimal @map("available_qty") @db.Decimal(12, 3)

  damagedQty Decimal? @map("damaged_qty") @db.Decimal(12, 3)

  buyingPrice Decimal @map("buying_price") @db.Decimal(12, 2)

  landingPrice Decimal @map("landing_price") @db.Decimal(12, 2)

  sellingPriceFrom Decimal? @map("selling_price_from") @db.Decimal(12, 2)

  sellingPriceTo Decimal? @map("selling_price_to") @db.Decimal(12, 2)

  remarks String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  purchaseReceiptItem PurchaseReceiptItem? @relation(fields: [purchaseReceiptItemId], references: [id])

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  slabs InventorySlab[]

  invoiceItems InvoiceItem[]

  @@map("inventory_batches")
}

model InventorySlab {
  id Int @id @default(autoincrement())

  inventoryBatchId Int @map("inventory_batch_id")

  serialNo String? @unique @map("serial_no")

  length Decimal? @db.Decimal(12, 2)

  width Decimal? @db.Decimal(12, 2)

  thickness Decimal? @db.Decimal(12, 2)

  sqft Decimal? @db.Decimal(12, 3)

  isCrack Boolean @default(false) @map("is_crack")

  isBroken Boolean @default(false) @map("is_broken")

  crackWidth Decimal? @map("crack_width") @db.Decimal(12, 2)

  crackHeight Decimal? @map("crack_height") @db.Decimal(12, 2)

  crackArea Decimal? @map("crack_area") @db.Decimal(12, 3)

  isSold Boolean @default(false) @map("is_sold")

  remarks String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  inventoryBatch InventoryBatch @relation(fields: [inventoryBatchId], references: [id])

  invoiceItems InvoiceItem[]

  @@map("inventory_slabs")
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIAL_PAID
  PAID
  CANCELLED
}

enum ItemType {
  PRODUCT
  SERVICE
  CHARGE
}

model Customer {
  id Int @id @default(autoincrement())

  name String

  mobile String?

  alternateMobile String? @map("alternate_mobile")

  address String?

  city String?

  state String?

  pincode String?

  gstNumber String? @map("gst_number")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  invoices Invoice[]

  tasks Task[]

  @@map("customers")
}

model Invoice {
  id Int @id @default(autoincrement())

  invoiceNumber String @unique @map("invoice_number")

  /// 'normal' | 'gst' — enforced by the invoice_type check constraint.
  invoiceType String @default("normal") @map("invoice_type")

  /// GSTIN printed on GST bills.
  gstNumber String? @map("gst_number")

  customerId Int @map("customer_id")

  invoiceDate DateTime @map("invoice_date")

  dueDate DateTime? @map("due_date")

  status InvoiceStatus @default(PENDING)

  isGst Boolean @default(false) @map("is_gst")

  isHalfGst Boolean @default(false) @map("is_half_gst")

  isTaxInclusive Boolean @default(false) @map("is_tax_inclusive")

  gstPercent Decimal? @map("gst_percent") @db.Decimal(5, 2)

  loadingRate Decimal? @map("loading_rate") @db.Decimal(12, 2)

  loadingAmount Decimal? @map("loading_amount") @db.Decimal(12, 2)

  receivedAmount Decimal? @default(0) @map("received_amount") @db.Decimal(12, 2)

  balanceAmount Decimal? @map("balance_amount") @db.Decimal(12, 2)

  paymentMethod String? @map("payment_method")
  accountId     Int?    @map("account_id")

  subtotal Decimal? @db.Decimal(12, 2)

  discountAmount Decimal? @map("discount_amount") @db.Decimal(12, 2)

  taxableAmount Decimal? @map("taxable_amount") @db.Decimal(12, 2)

  cgstAmount Decimal? @map("cgst_amount") @db.Decimal(12, 2)

  sgstAmount Decimal? @map("sgst_amount") @db.Decimal(12, 2)

  igstAmount Decimal? @map("igst_amount") @db.Decimal(12, 2)

  totalTaxAmount Decimal? @map("total_tax_amount") @db.Decimal(12, 2)

  roundOffAmount Decimal? @map("round_off_amount") @db.Decimal(12, 2)

  grandTotal Decimal? @map("grand_total") @db.Decimal(12, 2)

  remarks String?

  convertedFromInvoiceId Int? @map("converted_from_invoice_id")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id])

  convertedFromInvoice Invoice? @relation("InvoiceConversion", fields: [convertedFromInvoiceId], references: [id])

  convertedInvoices Invoice[] @relation("InvoiceConversion")

  items InvoiceItem[]

  commissions InvoiceCommission[]

  invoiceTransports InvoiceTransport[]

  payments InvoicePayment[]

  @@index([customerId])
  @@index([invoiceType])
  @@index([invoiceDate, isActive, status])
  @@map("invoices")
}

/// One row per independent numbering sequence: 'normal' and 'gst'.
model InvoiceNumberSequence {
  /// 'normal' | 'gst' — enforced by the invoice_number_sequences_scope_check constraint.
  scope         String   @id
  prefix        String
  currentNumber Int      @default(0) @map("current_number")
  paddingDigits Int      @default(3) @map("padding_digits")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("invoice_number_sequences")
}

model InvoicePayment {
  id Int @id @default(autoincrement())

  invoiceId Int @map("invoice_id")

  amount Decimal @db.Decimal(12, 2)

  paymentMethod String? @map("payment_method")

  accountId Int? @map("account_id")

  paymentDate DateTime @default(now()) @map("payment_date")

  remarks String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  account Account? @relation(fields: [accountId], references: [id])

  @@index([invoiceId])
  @@map("invoice_payments")
}

model InvoiceItem {
  id Int @id @default(autoincrement())

  invoiceId Int @map("invoice_id")

  itemType ItemType @map("item_type")

  productVariantId Int? @map("product_variant_id")

  inventoryBatchId Int? @map("inventory_batch_id")

  inventorySlabId Int? @map("inventory_slab_id")

  description String?

  unitId Int? @map("unit_id")

  secondaryUnitId Int? @map("secondary_unit_id")

  qty Decimal @db.Decimal(12, 3)

  slabCount Int? @map("slab_count")

  isLoadingApplicable Boolean @default(true) @map("is_loading_applicable")

  rate Decimal @db.Decimal(12, 2)

  discountAmount Decimal? @map("discount_amount") @db.Decimal(12, 2)

  taxPercent Decimal? @map("tax_percent") @db.Decimal(5, 2)

  taxAmount Decimal? @map("tax_amount") @db.Decimal(12, 2)

  amount Decimal @db.Decimal(12, 2)

  remarks String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])

  inventoryBatch InventoryBatch? @relation(fields: [inventoryBatchId], references: [id])

  inventorySlab InventorySlab? @relation(fields: [inventorySlabId], references: [id])

  unit Unit? @relation("InvoiceUnit", fields: [unitId], references: [id])

  secondaryUnit Unit? @relation("InvoiceSecondaryUnit", fields: [secondaryUnitId], references: [id])

  @@index([invoiceId])
  @@index([productVariantId])
  @@index([inventoryBatchId])
  @@index([inventorySlabId])
  @@index([unitId])
  @@index([secondaryUnitId])
  @@map("invoice_items")
}

model Broker {
  id Int @id @default(autoincrement())

  name String

  mobile String?

  address String?

  commissionPercent Decimal? @map("commission_percent") @db.Decimal(5, 2)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  invoiceCommissions InvoiceCommission[]

  tasks Task[]

  @@map("brokers")
}

model InvoiceCommission {
  id Int @id @default(autoincrement())

  invoiceId Int @map("invoice_id")

  brokerId Int @map("broker_id")

  commissionPercent Decimal? @map("commission_percent") @db.Decimal(5, 2)

  commissionAmount Decimal @map("commission_amount") @db.Decimal(12, 2)

  isPaid Boolean @default(false) @map("is_paid")

  paidDate DateTime? @map("paid_date")

  remarks String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  broker Broker @relation(fields: [brokerId], references: [id])

  @@index([invoiceId])
  @@index([brokerId])
  @@map("invoice_commissions")
}

model TransportProvider {
  id Int @id @default(autoincrement())

  name String

  mobile String?

  vehicleNumber String? @map("vehicle_number")

  address String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  invoiceTransports InvoiceTransport[]

  purchaseTransports PurchaseTransport[]

  tasks Task[]

  @@map("transport_providers")
}

model InvoiceTransport {
  id Int @id @default(autoincrement())

  invoiceId Int @map("invoice_id")

  transportProviderId Int @map("transport_provider_id")

  transportDate DateTime @map("transport_date")

  vehicleNumber String? @map("vehicle_number")

  fromLocation String? @map("from_location")

  toLocation String? @map("to_location")

  amount Decimal @db.Decimal(12, 2)

  isPaid Boolean @default(false) @map("is_paid")

  paidDate DateTime? @map("paid_date")

  remarks String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  transportProvider TransportProvider @relation(fields: [transportProviderId], references: [id])

  @@index([invoiceId])
  @@index([transportProviderId])
  @@map("invoice_transports")
}

model PurchaseTransport {
  id Int @id @default(autoincrement())

  purchaseReceiptId Int @map("purchase_receipt_id")

  transportProviderId Int @map("transport_provider_id")

  transportDate DateTime @map("transport_date")

  vehicleNumber String? @map("vehicle_number")

  fromLocation String? @map("from_location")

  toLocation String? @map("to_location")

  amount Decimal @db.Decimal(12, 2)

  isPaid Boolean @default(false) @map("is_paid")

  paidDate DateTime? @map("paid_date")

  remarks String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  purchaseReceipt PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id])

  transportProvider TransportProvider @relation(fields: [transportProviderId], references: [id])

  @@index([purchaseReceiptId])
  @@index([transportProviderId])
  @@map("purchase_transports")
}

model LookupOption {
  id Int @id @default(autoincrement())

  group String

  value String

  label String

  color String?

  sortOrder Int @default(0) @map("sort_order")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([group, value])
  @@map("lookup_options")
}

model Setting {
  key String @id

  value String

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Account {
  id             Int         @id @default(autoincrement())
  name           String
  type           AccountType
  ownerTag       String?     @map("owner_tag")
  initialBalance Decimal     @default(0) @map("initial_balance") @db.Decimal(12, 2)
  currentBalance Decimal     @default(0) @map("current_balance") @db.Decimal(12, 2)
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  transactions AccountTransaction[]

  invoicePayments InvoicePayment[]

  @@map("accounts")
}

model AccountTransaction {
  id              Int                    @id @default(autoincrement())
  accountId       Int                    @map("account_id")
  type            AccountTransactionType
  amount          Decimal                @db.Decimal(12, 2)
  balanceAfter    Decimal                @map("balance_after") @db.Decimal(12, 2)
  referenceId     String?                @map("reference_id")
  referenceType   String?                @map("reference_type")
  note            String?
  transactionDate DateTime               @default(now()) @map("transaction_date")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("account_transactions")
}

model CompanySettings {
  id                Int      @id @default(1)
  companyName       String   @default("Jayam Granites") @map("company_name")
  address           String?
  logoUrl           String?  @map("logo_url") @db.Text
  website           String?
  primaryPhone      String?  @map("primary_phone")
  secondaryPhone    String?  @map("secondary_phone")
  email             String?
  gstNumber         String?  @map("gst_number")
  panNumber         String?  @map("pan_number")
  tanNumber         String?  @map("tan_number")
  bankName          String?  @map("bank_name")
  accountHolderName String?  @map("account_holder_name")
  accountNumber     String?  @map("account_number")
  ifscCode          String?  @map("ifsc_code")
  branch            String?
  upiId             String?  @map("upi_id")
  upiQrUrl          String?  @map("upi_qr_url") @db.Text
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("organization_profiles")
}

model SystemConfiguration {
  id          String   @id @default(cuid())
  configKey   String   @unique @map("config_key")
  configLabel String   @map("config_label")
  configValue String   @map("config_value") @db.Text
  dataType    String   @map("data_type")
  options     Json?    @db.JsonB
  category    String   @default("General")
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category, configLabel])
  @@map("system_configurations")
}

model UpiProfile {
  id        Int      @id @default(autoincrement())
  payeeVPA  String   @map("payee_vpa")
  payeeName String   @map("payee_name")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isDefault])
  @@map("upi_profiles")
}

model ResourceContact {
  id           Int              @id @default(autoincrement())
  name         String
  mobile       String
  contactType  TradeContactType @map("contact_type")
  tierGroup    TierGroup        @default(BRONZE) @map("tier_group")
  productNotes String?          @map("product_notes")
  address      String?
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  tasks        Task[]

  @@index([mobile])
  @@index([contactType])
  @@index([tierGroup])
  @@map("resource_contacts")
}

model CustomerEnquiry {
  id                Int           @id @default(autoincrement())
  customerName      String        @map("customer_name")
  mobile            String
  requirementsNotes String        @map("requirements_notes")
  status            EnquiryStatus @default(OPEN)
  followUpCount     Int           @default(0) @map("follow_up_count")
  closeReason       String?       @map("close_reason")
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  tasks             Task[]

  @@index([mobile])
  @@index([status])
  @@map("customer_enquiries")
}

model Task {
  id          Int                @id @default(autoincrement())
  title       String
  description String?
  dueDate     DateTime           @map("due_date")
  priority    Priority           @default(MEDIUM)
  status      TaskStatus         @default(PENDING)
  enquiryId   Int?               @map("enquiry_id")
  resourceId  Int?               @map("resource_id")
  customerId  Int?               @map("customer_id")
  supplierId  Int?               @map("supplier_id")
  brokerId    Int?               @map("broker_id")
  transportId Int?               @map("transport_id")
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  enquiry     CustomerEnquiry?   @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  resource    ResourceContact?   @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  customer    Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supplier    Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  broker      Broker?            @relation(fields: [brokerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  transport   TransportProvider? @relation(fields: [transportId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([dueDate])
  @@index([status])
  @@index([enquiryId])
  @@index([resourceId])
  @@index([customerId])
  @@index([supplierId])
  @@index([brokerId])
  @@index([transportId])
  @@map("tasks")
}

model ProductImportJob {
  id            Int      @id @default(autoincrement())
  jobId         String   @unique @map("job_id")
  status        String   @default("queued")
  phase         String?
  progress      Int      @default(0)
  totalRows     Int      @default(0) @map("total_rows")
  processedRows Int      @default(0) @map("processed_rows")
  fileName      String   @map("file_name")
  fileBytes     Bytes?   @map("file_bytes")
  requestedById String?  @map("requested_by_id")
  preview       Json?
  result        Json?
  error         Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("product_import_jobs")
}
