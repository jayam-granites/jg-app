DATABASE_URL=postgresql://user:password@localhost:5432/jg_app
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173
EXPENSE_SCHEDULE_TIME_ZONE=Asia/Kolkata
# Configure all three OpenWA values to enable task reminders.
# Use the server root URL (for example, http://localhost:2785), not /api/docs.
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SESSION_ID=
# Bootstrap the initial super admin when running the Prisma seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_ADMIN_ROLE=super_admin
