# Copy to .env (gitignored) to override the defaults in docker-compose.yml:
#   cp .env.docker.example .env
# All URLs below are seen by the browser on the host, not by the containers.

# Database (URL-encode special characters in the password)
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=jg_app
DB_PORT=5432

# Host ports
API_PORT=3001
WEB_PORT=5173

# Browser -> API URL; changing it requires rebuilding the web image.
VITE_API_URL=http://localhost:3001
# CORS and auth URLs must match what the browser uses.
WEB_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3001
# Use a random 32+ character value outside local development.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

NODE_ENV=production
LOG_LEVEL=info
EXPENSE_SCHEDULE_TIME_ZONE=Asia/Kolkata

# Optional WhatsApp reminders: set all three or leave all three empty.
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SESSION_ID=

# Optional bootstrap admin used by the Prisma seed command.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_ADMIN_ROLE=admin
